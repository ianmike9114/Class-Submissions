rules_version = '2';

// This is the ONLY admin check in the whole app - no separate admin system.
// Also duplicated in js/firebase-config.js - keep both in sync.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() && request.auth.token.email == "galutira.ianjoseph.f@gmail.com";
    }

    // subjects: everyone signed in can read (for lists/join flow), only teacher writes
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // sections: read needed so students can validate a join code client-side
    match /sections/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // assignments: read needed for students to see their section's work
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // submissions: student creates their own (a link, no file upload), only
    // teacher updates AI draft / final grade / status
    match /submissions/{submissionId} {
      allow create: if isSignedIn()
                    && request.resource.data.studentUID == request.auth.uid;
      allow read: if isSignedIn()
                  && (resource.data.studentUID == request.auth.uid || isTeacher());
      allow update: if isTeacher();
      // A student may retract their own submission, but only while it's
      // still pending - once published (graded), it's teacher-only, same
      // as any other change to a graded submission.
      allow delete: if isTeacher()
                    || (isSignedIn()
                        && resource.data.studentUID == request.auth.uid
                        && resource.data.status == "pending");
    }

    // enrollments: one doc per student linking them to a subject+section via join code
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn()
                  && (resource.data.studentUID == request.auth.uid || isTeacher());
      allow create: if isSignedIn()
                    && request.resource.data.studentUID == request.auth.uid;
      // Students may self-correct a garbled Google display name, and may
      // flag a request to leave the class (leaveRequested) - but may only
      // ever touch those two fields on their own enrollment. Everything
      // else (which subject/section, studentEmail) stays teacher-controlled,
      // and delete stays teacher-only below - a request is just a flag, the
      // teacher still has to act on it.
      allow update: if isTeacher()
                    || (isSignedIn()
                        && resource.data.studentUID == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentName', 'leaveRequested']));
      allow delete: if isTeacher();
    }
  }
}
