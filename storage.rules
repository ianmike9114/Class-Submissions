rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() && request.auth.token.email == "galutira.ianjoseph.f@gmail.com";
    }

    // submissions/{studentUID}/{assignmentId}/{fileName}
    // student can only write into their own folder; teacher can read everything
    match /submissions/{studentUID}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == studentUID || isTeacher());
      allow write: if isSignedIn() && request.auth.uid == studentUID
                   && request.resource.size < 25 * 1024 * 1024; // 25MB cap, video goes via link not upload
    }
  }
}
